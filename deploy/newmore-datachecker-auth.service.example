[Unit]
Description=NewMore DataChecker authentication service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=newmore-auth
Group=newmore-auth
WorkingDirectory=/opt/newmore-datachecker/auth/current
EnvironmentFile=/data/newmore-datachecker/auth/auth.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/newmore-datachecker/auth/current/auth_server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
